# SMTP settings for the contact form email notifications
# If these are not set, the form falls back to opening the user's email client.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
ADMIN_EMAIL=info@primehireminds.com

# Optional: server port for production start script
PORT=7009
